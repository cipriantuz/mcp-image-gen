# Copy the variables you need into the MCP server's environment. All are optional.

# Cloud backend (OpenAI Images API). Without a key, `auto` uses ComfyUI only.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=300000

# Local backend (Qwen-Image 2.1 on ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=1200000
# COMFYUI_POLL_MS=2000
# Model file names as they appear in your ComfyUI models folders
# QWEN_UNET=qwen_image_2.1_int8_convrot.safetensors
# QWEN_CLIP=qwen3vl_8b_int8_convrot.safetensors
# QWEN_VAE=qwen_image_2.1_vae_bf16.safetensors

# Where images go when the call gives no output path (default: ~/Pictures/mcp-image-gen)
# IMAGE_OUTPUT_DIR=
# How long `auto` skips the cloud after a rate-limit error (ms)
# CLOUD_PAUSE_MS=900000
